[Unit]
Description=JARVIS OS Event Bus & Security Monitoring
Requires=jarvis-core.service
After=jarvis-core.service

[Service]
Type=simple
User=jarvis
Group=jarvis
ExecStart=/usr/bin/python3 -m jarvis_core.cli eventbus-daemon
Environment="PYTHONPATH=/opt/jarvis/python"
Restart=always
RestartSec=3s

# Removed CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
CapabilityBoundingSet=
ProtectSystem=full
ReadOnlyPaths=/var/log
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
