[Unit]
Description=JARVIS OS Core API and Control Layer
Wants=jarvis-local-ai.service
After=network.target jarvis-local-ai.service

[Service]
Type=simple
User=jarvis
Group=jarvis
ExecStartPre=/bin/bash -c 'until curl -s http://127.0.0.1:8081/health >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/python3 -m jarvis_core.cli daemon
Environment="PYTHONPATH=/opt/jarvis/python"
Environment="JARVIS_AI_PROVIDER=openai-compatible"
Environment="JARVIS_AI_MODEL=local-1B-emergency"
Environment="JARVIS_AI_FALLBACK=local-llama" 
Environment="JARVIS_LOCAL_AI_MODEL=qwen3-1.7b-q4_k_m" 
Environment="JARVIS_LOCAL_AI_BASE_URL=http://127.0.0.1:8081/v1" 

Restart=on-failure
RestartSec=5s

# Security Hardening for the daemon itself
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
ProtectSystem=strict
ReadWritePaths=/var/log/jarvis /var/lib/jarvis
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
